        </ui:VisualElement>
        <ui:VisualElement name="info-container" style="flex-grow: 0; background-color: rgb(99, 81, 81); flex-shrink: 0; flex-basis: 45%;">
            <ui:TabView style="font-size: 40px;">
                <ui:Tab label="Moves" name="moves-tab">
                    <ui:VisualElement name="navigation-bar" style="flex-grow: 1; flex-basis: 7%; flex-direction: row;">
                        <ui:Button text="&lt;&lt;" name="to-beginning-button" class="move-history-navigation-button" />
                        <ui:Button text="&lt;" name="back-button" class="move-history-navigation-button" />
                        <ui:Button text="&gt;" name="forward-button" class="move-history-navigation-button" />
                        <ui:Button text="&gt;&gt;" name="to-end-button" class="move-history-navigation-button" />
                    </ui:VisualElement>
                    <ui:ListView allow-add="false" allow-remove="false" name="move-entries-list" selection-type="None" fixed-item-height="40" show-bound-collection-size="false" style="flex-grow: 1; flex-basis: 93%;" />
                </ui:Tab>
                <ui:Tab label="New Game" name="new-game-tab">
                    <ui:DropdownField label="Play As:" name="play-as-dropdown" />
                    <ui:DropdownField label="Opponent Type:" name="play-against-dropdown" />
                    <ui:DropdownField label="Time Control:" name="time-control-dropdown" />
                    <ui:DropdownField label="Piece Set:" name="piece-set-dropdown" />
                    <ui:Button text="Play!" name="play-button" />
                </ui:Tab>
            </ui:TabView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
