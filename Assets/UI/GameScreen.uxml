                    <ui:VisualElement name="file-labels-container" style="flex-grow: 1; background-color: rgb(4, 97, 101); flex-basis: 90%;">
                        <ui:Label text="a" name="a-label" class="coord-label files" />
                        <ui:Label text="b" name="b-label" class="coord-label files" />
                        <ui:Label text="c" name="c-label" class="coord-label files" />
                        <ui:Label text="d" name="d-label" class="coord-label files" />
                        <ui:Label text="e" name="e-label" class="coord-label files" />
                        <ui:Label text="f" name="f-label" class="coord-label files" />
