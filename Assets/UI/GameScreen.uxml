                        <ui:VisualElement name="promotion-panel" style="flex-grow: 1; position: absolute; right: 0; bottom: 0; left: 0; background-color: rgba(0, 0, 0, 0.4); top: 0; visibility: hidden;">
                            <ui:VisualElement name="promotion-background" style="flex-wrap: wrap; flex-basis: 33%; top: 33%; left: 33%; width: 33%; border-top-left-radius: 15px; border-top-width: 5px; border-left-color: rgba(43, 87, 93, 0.75); border-right-color: rgba(43, 87, 93, 0.75); border-top-color: rgba(43, 87, 93, 0.75); border-bottom-color: rgba(43, 87, 93, 0.75); border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; background-color: rgba(43, 87, 93, 0.75); flex-direction: row;">
                                <ui:Button text="♞" name="knight-election-button" style="flex-basis: 45%; flex-shrink: 1; height: 45%; margin-top: 2.5%; margin-right: 2.5%; margin-bottom: 2.5%; margin-left: 2.5%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 100px;" />
                                <ui:Button text="♝" name="bishop-election-button" style="flex-basis: 45%; flex-shrink: 1; height: 45%; margin-top: 2.5%; margin-right: 2.5%; margin-bottom: 2.5%; margin-left: 2.5%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 100px;" />
                                <ui:Button text="♜" name="rook-election-button" style="flex-basis: 45%; flex-shrink: 1; height: 45%; margin-top: 2.5%; margin-right: 2.5%; margin-bottom: 2.5%; margin-left: 2.5%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 100px;" />
                                <ui:Button text="♛" name="queen-election-button" style="flex-basis: 45%; flex-shrink: 1; height: 45%; margin-top: 2.5%; margin-right: 2.5%; margin-bottom: 2.5%; margin-left: 2.5%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 100px;" />
                                <ui:Button text="X" name="promotion-cancel-button" style="position: absolute; right: -5%; top: -5%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgb(166, 0, 0); width: 10%; height: 10%; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
