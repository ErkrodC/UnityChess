:root {
}

#background {
    background-color: rgb(67, 62, 60);
}

.coord-label {
    font-size: 36px;
}

.ranks {
    flex-direction: row;
    -unity-text-align: middle-center;
    width: 100%;
}

.files {
    flex-direction: column;
    -unity-text-align: middle-center;
    height: 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#files-spacer {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 3%;
}

#rank-labels-container {
    flex-grow: 0;
    flex-shrink: 1;
    justify-content: space-between;
    flex-direction: column-reverse;
    flex-basis: 3%;
    margin-top: 3%;
    margin-bottom: 3%;
}

#file-labels-container {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 90%;
    flex-direction: row;
    justify-content: space-around;
}

.dark-square {
    background-color: rgb(78, 75, 71);
}

.light-square {
    background-color: rgb(196, 186, 165);
}

.board-square {
    width: 100%;
    height: 12.5%;
}

.tab-label {
}
